# Local development only. Copy to .env.local; never commit real credentials.
# npm run db:env fills .env.local from the running local stack without printing keys.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Privileged SERVER-ONLY key for local admin/privacy operations. Never prefix NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
SITE_URL=http://localhost:3000
