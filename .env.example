# Local template. Copy to .env.local; never commit credentials.
# For staging/production set these in the host secret manager, not this file.
# SITE_URL is the exact canonical HTTPS origin; Supabase must also use HTTPS.
# Keep local application and Supabase endpoints paired; never mix local and hosted.
# npm run db:env fills .env.local from the running local stack without printing keys.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Privileged SERVER-ONLY key for authenticated account deletion/admin operations.
# Use the matching environment project; never prefix this credential NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
SITE_URL=http://localhost:3000
# Book search (optional). SERVER-ONLY Google Books API key; never prefix NEXT_PUBLIC_.
# Without it, book search uses Open Library only.
GOOGLE_BOOKS_API_KEY=
# Google Calendar (#35, read-only). All SERVER-ONLY; never prefix NEXT_PUBLIC_.
# OAuth "Web application" client from your Google Cloud project. Authorized redirect URI: <SITE_URL>/api/google/callback
# Without these three, Settings says Google Calendar isn't set up; the rest of Muse is unaffected.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# 32 random bytes, base64 (openssl rand -base64 32). Encrypts stored Google tokens. Use a different key per environment;
# changing it makes stored tokens unreadable (people would need to reconnect).
GOOGLE_TOKEN_KEY=
