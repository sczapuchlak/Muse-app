   "tone": [
    "steady",
    "warm"
   ],
   "variants": [
    {
     "id": "a",
     "title": "You keep returning to {ritual}.",
     "body": "{complete} full goals out of {recorded} logged opportunities, the highest share among your rituals. Days you didn’t log aren’t counted against it."
    },
    {
     "id": "b",
     "title": "Back to {ritual}.",
     "body": "{complete} of {recorded} logged opportunities met in full. Quietly, it has become something your weeks are built around."
    },
    {
     "id": "c",
     "title": "{ritual} has staying power.",
     "body": "Of {recorded} logged chances, {complete} were full goals. That’s the steadiest rhythm in your rituals right now."
    }
   ],
   "variables": {
    "ritual": {
     "fact": "ritual",
     "format": "label"
    },
    "complete": {
